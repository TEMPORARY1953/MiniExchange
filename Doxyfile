OUTPUT_DIRECTORY       = $(MINI_EXCHANGE_DOCS_DIR)
OUTPUT_LANGUAGE        = English
INPUT_ENCODING         = UTF-8
INPUT                  = include src README.md Pipeline.md "test&research.md"
FILE_PATTERNS          = *.hpp *.cpp *.md
